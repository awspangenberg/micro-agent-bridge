<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tray app and onboarding shell. .NET Framework 4.8 ships with Windows 10/11, so no runtime is bundled. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MicroAgentBridge</AssemblyName>
    <RootNamespace>MicroAgentBridge</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Micro Agent Bridge</Product>
    <Company>awspangenberg</Company>
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>  </PropertyGroup>
  <PropertyGroup Condition="'$(MabIcon)' != ''">
    <ApplicationIcon>$(MabIcon)</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
